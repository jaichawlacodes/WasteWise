# ── Environment variable reference (placeholders only — never commit real values) ──
# Copy to `.env` locally and fill in. Server-side secrets (DATABASE_URL,
# GEMINI_API_KEY, UPSTASH_REDIS_*) must never be prefixed with NEXT_PUBLIC_.

# PostgreSQL (Supabase) connection string — used by the app runtime.
DATABASE_URL=

# Alternative target connection used by migration/verification scripts.
TARGET_DATABASE_URL=

# Web3Auth project public client ID (exposed client-side via next.config.mjs).
WEB3_AUTH_CLIENT_ID=

# Google Gemini API key (server-side only).
GEMINI_API_KEY=
# Optional Gemini model override (default: gemini-3.6-flash).
GEMINI_MODEL=

# ── Upstash Redis (server-side, REST over HTTPS — serverless-safe) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rate limiting (optional overrides; values shown are the defaults) ──
# Gemini: short-window burst limit per IP.
RATE_LIMIT_GEMINI_MAX=10
RATE_LIMIT_GEMINI_WINDOW=60
# Gemini: hourly safety limit per IP.
RATE_LIMIT_GEMINI_HOURLY_MAX=120
RATE_LIMIT_GEMINI_HOURLY_WINDOW=3600
# Geocode: per-IP limit (respects Nominatim/OSM usage policy).
RATE_LIMIT_GEOCODE_MAX=30
RATE_LIMIT_GEOCODE_WINDOW=60
# Redis failure policy: 0 = fail open (allow when Redis unavailable), 1 = fail closed (deny).
RATE_LIMIT_STRICT=0